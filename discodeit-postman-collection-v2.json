        },
        {
          "name": "Create Private Channel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participantIds\": [\n    \"{{userId}}\",\n    \"{{userId2}}\"\n  ]\n}"
