{
  "info": {
    "name": "discodeit-rest-api-checklist",
    "_postman_id": "7c7f1e1d-8c33-4b3f-a2df-1a7a8b72c001",
    "description": "Discodeit REST API collection.\n1) Set baseUrl.\n2) Run user/channel/message/readStatus create or list requests first.\n3) Copy returned UUIDs into collection variables.\n4) Then run PATCH/DELETE/detail requests.\nFor multipart requests, use Postman form-data and replace placeholder values/files as needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "userId2",
      "value": ""
    },
    {
      "key": "channelId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    },
    {
      "key": "readStatusId",
      "value": ""
    },
    {
      "key": "binaryContentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "User",
      "item": [
        {
          "name": "Create User (multipart)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "userCreateRequest",
                  "type": "text",
                  "value": "{\n  \"username\": \"tester1\",\n  \"email\": \"tester1@test.com\",\n  \"password\": \"1234\"\n}",
                  "contentType": "application/json"
                },
                {
                  "key": "profile",
                  "type": "file",
                  "src": [],
                  "disabled": true
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Create user. profile is optional."
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          }
        },
        {
          "name": "Update User (multipart)",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "userUpdateRequest",
                  "type": "text",
                  "value": "{\n  \"newUsername\": \"tester1_updated\",\n  \"newEmail\": \"tester1_updated@test.com\",\n  \"newPassword\": \"5678\"\n}",
                  "contentType": "application/json"
                },
                {
                  "key": "profile",
                  "type": "file",
                  "src": [],
                  "disabled": true
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            },
            "description": "Update user. Set userId variable first."
          }
        },
        {
          "name": "Update User Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newLastActiveAt\": \"2026-04-22T13:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}/userStatus",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}",
                "userStatus"
              ]
            },
            "description": "Set userId variable first."
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            },
            "description": "Set userId variable first."
          }
        }
      ]
    },
