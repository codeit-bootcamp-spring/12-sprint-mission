                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            },
            "description": "Set userId variable first."
          }
        },
        {
          "name": "Update Public Channel",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
