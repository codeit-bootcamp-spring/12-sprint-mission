            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"general\",\n  \"description\": \"public channel\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/channels/public",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "channels",
                "public"
              ]
            }
