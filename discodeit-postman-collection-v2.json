            "body": {
              "mode": "raw",
              "raw": "{\n  \"newName\": \"general-updated\",\n  \"newDescription\": \"updated description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/channels/{{channelId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "channels",
                "{{channelId}}"
              ]
            },
            "description": "Set channelId variable first."
          }
        },
        {
          "name": "Delete Channel",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/channels/{{channelId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "channels",
                "{{channelId}}"
              ]
            },
            "description": "Set channelId variable first."
